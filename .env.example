# =====================================================================
# CHE NE SAI?! – variabili d'ambiente
# Copia in .env.local (sviluppo) o imposta su Vercel (staging/produzione).
# NON committare mai valori reali.
# =====================================================================

# --- Supabase (Project Settings → API) --------------------------------
# URL del progetto
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chiave pubblica (publishable / anon): usata dal browser solo per Realtime e login admin
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Chiave segreta (secret / service_role): SOLO server (Storage firmato, gestione admin)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Database (Project Settings → Database → Connection string) -------
# In produzione usa il pooler in "Transaction mode" (porta 6543).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Connessioni massime per istanza serverless (default 5)
DATABASE_POOL_MAX=5

# --- Applicazione -------------------------------------------------------
# URL pubblico usato nel QR code (dominio personalizzato in produzione)
NEXT_PUBLIC_APP_URL=https://chenesai.example.it

# --- Opzionale: voce professionale ElevenLabs (altrimenti voce gratuita del browser) ---
# Le battute generate vengono salvate nel bucket privato "tts" e registrate in tts_clips
# (si pagano una volta sola). La chiave resta SOLO sul server.
# ELEVENLABS_API_KEY=
# ID voce di riserva per ruolo (le voci si scelgono di solito in admin → Voci):
# ELEVENLABS_VOICE_PROFESSORE=
# ELEVENLABS_VOICE_REGINA=
# ELEVENLABS_VOICE_PALMINO=
# ELEVENLABS_VOICE_ANNUNCIATORE=
# Modello delle battute pre-generate (domande, round, eventi, frasi fisse): qualità, con audio tag ([laughs], [shouts]…)
# ELEVENLABS_MODEL=eleven_v4
# Modello delle battute live (nickname, punteggi): bassa latenza, con audio tag (~1 s per battuta)
# ELEVENLABS_MODEL_LIVE=eleven_v4_turbo
# Con modelli senza audio tag (es. eleven_multilingual_v2, eleven_flash_v2_5) i tag vengono tolti dal testo.
# Budget: il limite mensile di caratteri dell'app (predefinito 50000) si imposta in admin → Voci;
# oltre il limite non si genera più nulla e il TV usa la voce del browser (le clip in cache restano).

# --- Opzionale: modelli 3D riggati dei personaggi (glTF/GLB) ------------
# I GLB in public/models/ sono attivi di default (intro e schermate TV in modalità 3D).
# Un URL "/...glb" sostituisce il file; "off" disattiva quel personaggio (torna il procedurale).
# Diagnostica senza riavvio: ?glb=0|1 (tutti) oppure ?glb_regina=0 (uno solo) nell'URL della pagina.
# NEXT_PUBLIC_QZ_GLB_PROFESSORE=/models/professore.glb
# NEXT_PUBLIC_QZ_GLB_REGINA=/models/regina.glb
# NEXT_PUBLIC_QZ_GLB_PALMINO=/models/palmino.glb

# --- Test end-to-end (solo sviluppo) ------------------------------------
# E2E_BASE_URL=http://localhost:3100
# E2E_ADMIN_EMAIL=admin@chenesai.local
# E2E_ADMIN_PASSWORD=...
